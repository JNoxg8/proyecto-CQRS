<?xml version="1.0" encoding="UTF-8"?>
<!--
  Parent POM of the "Tienda de calzado CQRS" solution.
  Every module inherits the Spring Boot versions and the Java version from here.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>

    <groupId>com.tienda</groupId>
    <artifactId>tienda-calzado-cqrs</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>Tienda de calzado CQRS</name>
    <description>CQRS + Kafka: servidor (comandos, consultas, notificaciones) y clientes web</description>

    <modules>
        <module>eventos</module>                  <!-- message contract shared by everyone -->
        <module>servicio-autenticacion</module>   <!-- users, login, JWT (RS256) -->
        <module>servicio-comandos</module>        <!-- write side: PostgreSQL -->
        <module>servicio-consultas</module>       <!-- read side: MongoDB + SSE -->
        <module>servicio-notificaciones</module>  <!-- second, independent Kafka consumer -->
        <module>cliente-web</module>              <!-- client apps: Tienda + Admin -->
    </modules>

    <properties>
        <java.version>21</java.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.tienda</groupId>
                <artifactId>eventos</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
